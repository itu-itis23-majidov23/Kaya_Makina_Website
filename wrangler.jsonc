{
  "$schema": "node_modules/wrangler/config-schema.json",

  // The Worker's name in the Cloudflare dashboard. Cloudflare's Git builds
  // deploy to the connected Worker whatever is written here, but a manual
  // `npx wrangler deploy` uses this name, so keep the two the same.
  "name": "kaya-makina-website",
  "compatibility_date": "2026-11-20",

  // The site is a static export: `next build` writes plain HTML, CSS, JS and
  // media to ./out, and Cloudflare serves that folder. Wrangler runs this
  // build itself before every deploy, so the "Build command" field in the
  // dashboard can stay empty.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /az/ is served from az/index.html; /az redirects to /az/
    "html_handling": "auto-trailing-slash",
    // unknown URLs get out/404.html with a real 404 status
    "not_found_handling": "404-page",
    // Only video requests pass through the script below. Everything else is
    // served straight from the asset store.
    "run_worker_first": ["/video/*"]
  },

  // The one piece of server code: it lets the videos be requested in parts,
  // which Safari on iPhone and Mac needs in order to play them.
  "main": "worker/video-range.js",

  // The live domain. Cloudflare creates the DNS records and certificates for
  // both hostnames on deploy. The zone must be in the same Cloudflare account.
  "routes": [
    { "pattern": "kayamakina.az", "custom_domain": true },
    { "pattern": "www.kayamakina.az", "custom_domain": true }
  ],

  // Also keep the *.workers.dev address, as a fallback for checking a deploy,
  // but no per-version preview addresses.
  "workers_dev": true,
  "preview_urls": false
}
